# LineHouse.id environment variables
# Copy this file to .env.local and fill in real values before running locally.
# Never commit real secrets to version control.

# NextAuth secret (generate with: openssl rand -base64 32)
AUTH_SECRET=your-auth-secret-here

# PostgreSQL connection string (e.g. Neon, Supabase, or self-hosted Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Cloudinary (optional - for image uploads in admin)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Site URL (used for metadata/OpenGraph)
NEXTAUTH_URL=http://localhost:3000
